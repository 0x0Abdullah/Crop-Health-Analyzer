# Crop Health Analyzer Environment Variables

# LLM Provider Configuration
LLM_PROVIDER=gemini # Options: gemini, openai, fallback
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-flash-latest  # gemini-1.5-flash has been retired; for OpenAI use e.g. gpt-4o-mini

# Vision Model Configuration
VISION_MODEL=default # Options: default, custom, api
VISION_CONFIDENCE_THRESHOLD=0.55

# RAG & Embeddings
EMBEDDING_MODEL=tfidf # Options: tfidf, sentence-transformers

# Application Mode
DEMO_MODE=true
